# ZMusic API Configuration
# Copy this file to .env and fill in your actual API keys

# Suno.cn API Key (get from https://www.suno.cn)
SUNO_CN_API_KEY=sk-your-api-key-here

# Suno API Base URL
SUNO_API_BASE_URL=https://mcp.suno.cn

# Muse AI Configuration (optional)
MUSE_AI_API_KEY=your-muse-api-key-here
MUSE_AI_BASE_URL=https://api.muse.ai

# Server Configuration
PORT=5500
HOST=localhost

# Environment
NODE_ENV=development

# Logging Configuration (log4j-style)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT_CONSOLE=true
LOG_OUTPUT_FILE=true
LOG_FILE_PATH=./logs/zmusic.log

# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/zmusic.db

# Unicorn Agent Configuration
AGENT_MAX_TASKS=5
AGENT_DECISION_THRESHOLD=0.7