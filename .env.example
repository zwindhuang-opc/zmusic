# ZMusic API Configuration
# Copy this file to .env and fill in your actual API keys

# Suno.cn API Key (get from https://www.suno.cn)
SUNO_CN_API_KEY=sk-your-api-key-here

# Suno API Base URL
SUNO_API_BASE_URL=https://mcp.suno.cn

# Muse (muse.top) Configuration - real song generation with vocals
# App Key is public (from muse.top JS bundle). User JWT comes from SMS login on muse.top.
# To get MUSE_API_KEY: log into https://muse.top, open DevTools > Application > Local Storage >
#   muse-user-store, copy the "token" field. Token is valid ~180 days.
MUSE_APP_KEY=8e33a5e60ef347df808d14026f27d227
MUSE_API_KEY=your-muse-jwt-token-here
MUSE_BASE_URL=https://project-api.atmob.com
# Vite-exposed (frontend reads these to know Muse is configured; the JWT itself
# is never sent to the browser - all generation goes through our /api/muse proxy)
VITE_MUSE_API_KEY=your-muse-jwt-token-here
VITE_MUSE_BASE_URL=https://project-api.atmob.com
# Muse Mock Mode: 1=simulate generation with fake data (no credits spent, for
# local testing). 0 or unset=real muse.top API calls.
MUSE_MOCK=0

# Server Configuration
PORT=5500
HOST=localhost

# Environment
NODE_ENV=development

# Logging Configuration (log4j-style)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT_CONSOLE=true
LOG_OUTPUT_FILE=true
LOG_FILE_PATH=./logs/zmusic.log

# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/zmusic.db

# Unicorn Agent Configuration
AGENT_MAX_TASKS=5
AGENT_DECISION_THRESHOLD=0.7