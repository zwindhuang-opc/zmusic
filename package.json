{
  "name": "zmusic",
  "version": "5.5.0",
  "description": "ZMusic - Real AI Music Generation Platform with MVC Architecture",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node src/server.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:run:android": "npm run build && npx cap sync android && npx cap run android",
    "cap:run:ios": "npm run build && npx cap sync ios && npx cap run ios",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:5500 electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-builder --dir",
    "version:bump": "node scripts/version-bump.js",
    "version:major": "node scripts/version-bump.js major",
    "version:minor": "node scripts/version-bump.js minor",
    "version:patch": "node scripts/version-bump.js patch",
    "version:current": "node scripts/version-bump.js --current",
    "backup": "git add -A && git commit -m \"Auto backup $(date +%Y-%m-%d_%H:%M:%S)\" && git push origin HEAD",
    "backup:tag": "git tag -f backup-$(date +%Y-%m-%d) && git push origin -f backup-$(date +%Y-%m-%d)",
    "screenshot": "node scripts/take-screenshots.mjs",
    "screenshot:version": "node scripts/take-screenshots.mjs --version"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/clipboard": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "kleur": "^4.1.5",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.32",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.zmusic.app",
    "productName": "ZMusic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/icons/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icons/icon-256.png",
      "uninstallerIcon": "resources/icons/icon-256.png",
      "installerHeaderIcon": "resources/icons/icon-256.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icons/icon-512.png"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "icon": "resources/icons"
    }
  }
}